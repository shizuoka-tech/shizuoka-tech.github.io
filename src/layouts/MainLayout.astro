---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

type Props = {
  title?: string;
  description?: string;
  headerVariant?: "transparent" | "solid";
};

const { title, description, headerVariant = "solid" } = Astro.props;
---

<html lang="ja-JP">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content="ShizuokaTECH, 静岡, プログラマー, 交流イベント" />
    {description && <meta name="description" content={description} />}
    <title>{title ? `${title} | ShizuokaTECH` : `ShizuokaTECH | 静岡で開催されるプログラマー交流イベント`}</title>
  </head>
  <body>
    <Header variant={headerVariant} />
    <slot />
    <Footer />
  </body>
</html>
