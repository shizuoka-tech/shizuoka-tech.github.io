---
import "../styles/global.css";

type Props = {
  title?: string;
};

const { title } = Astro.props;
---

<html lang="ja-JP">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content="ShizuokaTECH, 静岡, プログラマー, 交流イベント" />
    <title>{title ? `${title} | ShizuokaTECH` : `ShizuokaTECH | 静岡で開催されるプログラマー交流イベント`}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
