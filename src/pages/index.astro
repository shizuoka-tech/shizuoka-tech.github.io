---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";

const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const formatDate = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---

<MainLayout headerVariant="transparent">
  <!-- Fixed blurring background -->
  <div
    id="hero-bg"
    class="fixed inset-0 -z-20 scale-110 bg-cover bg-center bg-no-repeat"
    style="background-image: url('/bg.jpg')"
  ></div>
  <!-- Dark overlay -->
  <div id="hero-overlay" class="fixed inset-0 -z-10" style="background-color: rgba(0,0,0,0.35)"></div>

  <!-- Hero Section -->
  <section class="relative h-screen flex flex-col items-center justify-center text-white text-center px-4">
    <p class="text-xs sm:text-sm font-semibold tracking-[0.4em] uppercase text-white/60 mb-5">
      Shizuoka Programmer Community
    </p>
    <h1 class="text-5xl sm:text-7xl md:text-8xl font-black tracking-wider drop-shadow-xl mb-6">
      ShizuokaTECH
    </h1>
    <p class="text-base sm:text-xl text-white/75 max-w-lg leading-relaxed">
      静岡のエンジニア・クリエイターが集まる<br />コミュニティイベント
    </p>

    <!-- Scroll indicator -->
    <div id="scroll-indicator" class="absolute bottom-10 flex flex-col items-center gap-2 text-white/50 text-xs tracking-widest uppercase">
      <span>Scroll</span>
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- Content Sections -->
  <div class="relative z-10">

    <!-- About Section -->
    <section class="bg-white py-24 px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">ShizuokaTECH とは</h2>
          <p class="mt-4 text-gray-500 max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
            「ShizuokaTECH」は、静岡のITコミュニティ活性化を目指した交流イベントです。学生、社会人を問わず、また取り扱う分野も限定しません。参加者が自由に知見を交換し合い、静岡のITコミュニティを共に盛り上げていきましょう。
          </p>
        </div>

      </div>
    </section>

    <!-- News Section -->
    <section class="bg-gray-50 py-24 px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <p class="text-indigo-600 font-semibold tracking-[0.3em] text-xs uppercase mb-3">News</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">お知らせ</h2>
        </div>

        <div class="space-y-4">
          {news.map((entry) => (
            <a
              href={`/news/${entry.id}`}
              class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex gap-4 items-start hover:shadow-md transition-shadow"
            >
              <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full whitespace-nowrap mt-0.5">
                {entry.data.category}
              </span>
              <div>
                <time class="text-xs text-gray-400 mb-1 block">{formatDate(entry.data.date)}</time>
                <p class="text-gray-800 font-medium text-sm sm:text-base">{entry.data.title}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
</MainLayout>

<script>
  const heroBg = document.getElementById('hero-bg') as HTMLElement;
  const heroOverlay = document.getElementById('hero-overlay') as HTMLElement;
  const scrollIndicator = document.getElementById('scroll-indicator') as HTMLElement;

  let ticking = false;

  function updateEffects() {
    const scrollY = window.scrollY;
    const vh = window.innerHeight;
    // Blur completes by 80% of viewport height scrolled
    const progress = Math.min(scrollY / (vh * 0.8), 1);

    heroBg.style.filter = `blur(${progress * 18}px)`;

    const overlayOpacity = 0.35 + progress * 0.35;
    heroOverlay.style.backgroundColor = `rgba(0,0,0,${overlayOpacity})`;

    scrollIndicator.style.opacity = String(1 - progress * 3);

    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateEffects);
      ticking = true;
    }
  }, { passive: true });
</script>
